# Copy thành .env và điền. .env đã git-ignore, không bao giờ commit.
#
# Vì sao nhiều tài khoản đến vậy: phần lớn case AUTH kiểm một TRẠNG THÁI tài khoản mà bộ
# test không tự tạo được (bị khoá, hết hạn, đã bật 2FA…), và nhiều trạng thái loại trừ
# nhau. Ai cần gì, chạy lại thì phải reset gì: `docs/test-data.md`.

# Chưa cấp được tài khoản nào đó thì điền WAITING_ACCOUNT vào key của nó thay vì để
# trống. Bộ test đọc chuỗi đó thành CHƯA CÓ (xem src/data/credentials.ts) nên case vẫn
# skip đúng như cũ — khác biệt duy nhất là người đọc file này biết ngay cái nào đang chờ
# cấp, cái nào chưa ai xét tới. Thứ tự nên cấp: docs/account-provisioning.md.
#
# Chọn một khối trong src/env.ts
TEST_ENV=beta

# URL của app. Điền vào đây thì thắng mọi môi trường, kể cả khi đổi TEST_ENV.
# Để trống thì lấy theo bảng trong src/env.ts.
#
# API_URL KHÔNG ở đây — nó nằm ở khối "Tầng API" cuối file, cùng ENTERPRISE_ID.
BASE_URL=

# Mã doanh nghiệp — bước 1 của đăng nhập, quyết định realm SSO nào được dùng
COMPANY_CODE=

# Tài khoản test (phải có sẵn trong môi trường đích)
USER_USERNAME=
USER_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=


# ============================================================================
# Tài khoản trạng thái CỐ ĐỊNH — test chỉ đọc, không làm đổi. Cấp một lần dùng mãi.
# ============================================================================

# Account Status = Expired — AUTH2.13
EXPIRED_USERNAME=
EXPIRED_PASSWORD=

# Bị vô hiệu hoá, chỉ Owner/Admin mở lại được — AUTH2.12
DISABLED_USERNAME=
DISABLED_PASSWORD=

# Đăng nhập được nhưng CHƯA có quyền truy cập chức năng nào — AUTH2.18
NO_PERMISSION_USERNAME=
NO_PERMISSION_PASSWORD=

# Username có thật nhưng thuộc tenant KHÁC với COMPANY_CODE — AUTH2.15
OTHER_TENANT_USERNAME=
OTHER_TENANT_PASSWORD=

# Đã tồn tại ở cả IdP lẫn app, đăng nhập SSO phải vào thẳng — AUTH2.4
SSO_EXISTING_USERNAME=
SSO_EXISTING_PASSWORD=

# Tài khoản RIÊNG cho mọi case phải nhập OTP khi đăng nhập — AUTH2.17 · 4.4 · 4.5 · 4.6 · 5.7
# OTP do ADMIN bật, không phải test bật. Suite chỉ đăng nhập và nhập mã, KHÔNG tự bật/tắt
# 2FA cho nó — nên case setup 2FA (4.0 · 4.3), khoá do sai OTP (4.9), tắt 2FA (4.11) phải
# dùng tài khoản khác, đừng dùng OTP_* ở đó.
# TOTP secret phải xin ngay lúc admin bật OTP; sau đó không lấy lại được.
# Backup codes ngăn cách bằng dấu phẩy — AUTH4.10.
OTP_USERNAME=
OTP_PASSWORD=
OTP_TOTP_SECRET=
OTP_BACKUP_CODES=


# ============================================================================
# Tài khoản mà test LÀM ĐỔI trạng thái — chạy lần hai không reset là đỏ.
#
# KHÔNG dùng lại USER_* ở đây: case khoá tài khoản sẽ khoá đúng tài khoản mà project
# `setup` dùng để đăng nhập, và cả suite đỏ ở lần chạy sau.
# ============================================================================

# Được phép bị khoá — AUTH2.7 · 2.8 · 2.9 · 2.19 · 2.20 · 2.21
# Reset: chờ hết lockout duration, hoặc nhờ Admin mở.
LOCKOUT_USERNAME=
LOCKOUT_PASSWORD=

# Luồng quên mật khẩu — AUTH3.3 · 3.6 → 3.10
# Nhận EMAIL THẬT, và AUTH3.9 đốt hạn mức 3 lần/NGÀY: chạy CI hai lượt trong ngày là đụng trần.
FORGOT_USERNAME=

# CHƯA TỪNG setup 2FA — AUTH4.0 · 4.3. Một chiều: setup xong là hết, phải cấp tài khoản mới.
FIRST_LOGIN_USERNAME=
FIRST_LOGIN_PASSWORD=

# Mật khẩu ĐÃ hết hạn — các bước ĐẦU của flow bắt buộc: AUTH2.11 · 7.0 · 7.1 · 7.2 · 7.3 · 7.4
# Những case này không hoàn tất đổi mật khẩu nên tài khoản còn nguyên trạng thái.
PWD_EXPIRED_USERNAME=
PWD_EXPIRED_PASSWORD=

# Mật khẩu ĐÃ hết hạn, RIÊNG cho nhóm đi hết flow — AUTH7.5 → 7.9
# Tách khỏi PWD_EXPIRED_* vì AUTH7.8 ĐỔI MẬT KHẨU THẬT: dùng chung thì sau lượt đầu, mật
# khẩu ở trên không còn đúng và AUTH7.2 → 7.4 đỏ theo.
# Nhóm này còn phải qua bước OTP, nên cần biết mã gửi tới đâu để đọc.
# Reset: đặt lại mật khẩu về giá trị dưới và ép nó hết hạn lại.
PWD_EXPIRED_OTP_USERNAME=
PWD_EXPIRED_OTP_PASSWORD=
# Email hoặc SĐT nhận mã OTP của flow này
PWD_EXPIRED_OTP_CHANNEL=

# Form Đổi mật khẩu — AUTH5.5 · 5.6 · 5.9. Mật khẩu đổi thật, phải đặt lại sau mỗi lần chạy.
CHANGE_PWD_USERNAME=
CHANGE_PWD_PASSWORD=

# CHƯA tồn tại ở app, chỉ có ở IdP — để app tự tạo lúc đăng nhập (JIT) — AUTH2.5
# Reset: xoá user khỏi app sau mỗi lần chạy.
SSO_NEW_USERNAME=
SSO_NEW_PASSWORD=


# ============================================================================
# Cấu hình của TENANT — không phải hằng số sản phẩm. Để trống thì case liên quan tự skip.
# ============================================================================

# Số lần đăng nhập sai tối đa trước khi khoá — AUTH2.8 · 2.9
LOCKOUT_MAX_ATTEMPTS=
# Tài khoản bị khoá trong bao nhiêu phút — AUTH2.21
LOCKOUT_DURATION_MINUTES=

# CHƯA CHỐT, xem docs/test-data.md mục 6 — chưa khai thành biến vì chưa có giá trị chính thức:
#   token TTL của link reset (AUTH3.10) · OTP TTL và max retry (AUTH4.9 · 4.12)
#   ngưỡng hiện CAPTCHA (AUTH2.10) · quy tắc reset bộ đếm sai (AUTH2.19)

# CHƯA CHỐT: cấu hình hộp thư có API (Mailosaur / MailHog / IMAP) — chặn AUTH3.3 · 3.7 ·
# 3.8 · 3.10 · 4.1 · 7.0 · 2.11. Chọn công cụ xong thì khai key ở đây.


# ============================================================================
# Hạ tầng
# ============================================================================

# Session đã cache được dùng lại bao lâu trước khi đăng nhập lại
SESSION_TTL_MINUTES=30

# Bearer token cấp sẵn cho spec API; để trống nếu API fixture tự lấy token
API_TOKEN=

# Hiện cửa sổ browser (1 = hiện). CI luôn headless, biến này bị bỏ qua.
HEADED=
# Chậm lại N mili giây mỗi thao tác, chỉ có tác dụng khi HEADED=1
SLOW_MO=

# debug | info | warn | error
LOG_LEVEL=info


# ============================================================================
# Tầng API
# ============================================================================

# Gateway. BẮT BUỘC điền — trong code không còn giá trị mặc định nào.
#
# Gateway là HOST KHÁC hẳn app, không phải đường dẫn con của BASE_URL:
#     BASE_URL  https://beta-vmsmart-next.fcam.vn    <- app (Next.js)
#     API_URL   https://beta-api-gateway.fcam.vn     <- gateway
#
# Điền nhầm host của app vào đây thì Next.js trả HTML kèm status 200 — test đọc được
# "response" nên KHÔNG đỏ, và rất lâu sau mới nhận ra. Đã dính một lần.
API_URL=https://beta-api-gateway.fcam.vn
# Doanh nghiệp mà tầng API thao tác lên. Sau khi đăng nhập, cookie `company_id` mang
# đúng giá trị này — lấy ở F12 → Application → Cookies nếu không ai cho biết.
ENTERPRISE_ID=
