# Copy sang .jira.env (đã gitignored) và điền token thật. KHÔNG commit .jira.env.
# Đặt ở ~/.jira.env (dùng chung mọi repo) hoặc ./.jira.env (riêng repo này).
# PAT tạo tại: jira.fcam.vn → Profile → Personal Access Tokens → Create token
FCAM_JIRA_PAT=
# Project mặc định cho lệnh 'jira task' (lệnh khác tự suy project từ issue key)
FCAM_JIRA_PROJECT=RPA
